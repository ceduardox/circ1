generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ContentType {
  REFLECTION
  AFFIRMATION
  VIDEO
  QUIZ
  MENTAL_EXERCISE
  CONFIDENCE_TASK
  INTERACTIVE_EXERCISE
}

enum ContentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ReflectionType {
  DREAMS
  FEARS
  ENTHUSIASM
  CUSTOM
}

enum MembershipStatus {
  INACTIVE
  ACTIVE
  REVOKED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  MEMBERSHIP
  MONTHLY
  CREATOR_EXTRA
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PAID
  RETENTED
}

enum TikTokCreatorStatus {
  PENDIENTE
  ACEPTADO
  ACTIVO
}

enum TikTokCommissionType {
  STUDENT
  SPONSOR
}

enum TikTokCommissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  username            String           @unique
  passwordHash        String           @map("password_hash")
  firstName           String?          @map("first_name")
  lastName            String?          @map("last_name")
  age                 Int?
  country             String?
  avatarUrl           String?          @map("avatar_url")
  role                UserRole         @default(USER)
  streakFreezes       Int              @default(2) @map("streak_freezes")
  membershipStatus    MembershipStatus @default(INACTIVE) @map("membership_status")
  membershipPaidAt    DateTime?        @map("membership_paid_at")
  membershipExpiresAt DateTime?        @map("membership_expires_at")
  balance             Float            @default(0)
  chatBlocked         Boolean          @default(false) @map("chat_blocked")
  pushEnabled         Boolean          @default(false) @map("push_enabled")
  pushChat            Boolean          @default(true) @map("push_chat")
  pushChatAll         Boolean          @default(false) @map("push_chat_all")
  pushCommissions     Boolean          @default(true) @map("push_commissions")
  pushPayments        Boolean          @default(true) @map("push_payments")
  referralCode        String?          @unique @map("referral_code")
  referrerId          String?          @map("referrer_id")
  referralPlans       Json?            @map("referral_plans")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  progress          UserProgress[]
  reflections       UserReflection[]
  notifications     Notification[]
  balanceLogs       BalanceLog[]
  payments          MembershipPayment[]
  commissions       Commission[]        @relation("CommissionReceiver")
  earnedFrom        Commission[]        @relation("CommissionSource")
  withdrawals       Withdrawal[]
  payoutAccounts    PayoutAccount[]
  referrer          User?               @relation("Referrals", fields: [referrerId], references: [id])
  referrals         User[]              @relation("Referrals")
  chatMessages      ChatMessage[]       @relation("ChatMessageSender")
  impersonatedIn    ChatMessage[]       @relation("ChatMessageAsUser")
  vipProProgress    VipProProgress[]
  teamContacts      TeamContact[]
  socialPosts       SocialPost[]
  tiktokCampaign    TikTokShopCampaign?
  tiktokCommissions TikTokCommission[]

  @@map("users")
}

model ChatMessage {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  asUserId  String?   @map("as_user_id")
  message   String
  imageUrl  String?   @map("image_url")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  sender User  @relation("ChatMessageSender", fields: [userId], references: [id], onDelete: Cascade)
  asUser User? @relation("ChatMessageAsUser", fields: [asUserId], references: [id], onDelete: SetNull)

  @@map("chat_messages")
}

model MembershipPayment {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  amount      Float
  planId      String?       @map("plan_id")
  planName    String?       @map("plan_name")
  type        PaymentType   @default(MEMBERSHIP)
  status      PaymentStatus @default(PENDING)
  method      String?
  reference   String?
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  processedAt DateTime?     @map("processed_at")
  processedBy String?       @map("processed_by")

  npPaymentId   String? @map("np_payment_id")
  npInvoiceUrl  String? @map("np_invoice_url")
  npStatus      String? @map("np_status")
  npPayAmount   Float?  @map("np_pay_amount")
  npPayCurrency String? @map("np_pay_currency")

  campaignId String? @map("campaign_id")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    TikTokShopCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  commissions Commission[]

  @@map("membership_payments")
}

model Commission {
  id           String           @id @default(uuid())
  paymentId    String           @map("payment_id")
  userId       String           @map("user_id")
  sourceUserId String           @map("source_user_id")
  level        Int
  percent      Float
  amount       Float
  status       CommissionStatus @default(PAID)
  createdAt    DateTime         @default(now()) @map("created_at")

  payment    MembershipPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user       User              @relation("CommissionReceiver", fields: [userId], references: [id], onDelete: Cascade)
  sourceUser User              @relation("CommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@map("commissions")
}

model Withdrawal {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  amount      Float
  feePercent  Float            @default(0) @map("fee_percent")
  method      String?
  account     String?
  details     Json?
  status      WithdrawalStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  processedAt DateTime?        @map("processed_at")
  processedBy String?          @map("processed_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model PayoutAccount {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  method    String
  label     String?
  address   String?
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @default("info")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model BalanceLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @default("credit")
  amount    Float
  balance   Float
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("balance_logs")
}

model ProgramDay {
  id          String    @id @default(uuid())
  dayNumber   Int       @unique @map("day_number")
  title       String
  description String?
  unlockDate  DateTime? @map("unlock_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  contents    DayContent[]
  progress    UserProgress[]
  reflections UserReflection[]

  @@map("program_days")
}

model DayContent {
  id         String      @id @default(uuid())
  dayId      String      @map("day_id")
  type       ContentType
  title      String
  content    Json
  orderIndex Int         @default(0) @map("order_index")
  isRequired Boolean     @default(true) @map("is_required")
  createdAt  DateTime    @default(now()) @map("created_at")

  day      ProgramDay     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  progress UserProgress[]

  @@map("day_contents")
}

model UserProgress {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  dayId       String        @map("day_id")
  contentId   String        @map("content_id")
  status      ContentStatus @default(PENDING)
  answers     Json?
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  content DayContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("user_progress")
}

model UserReflection {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  dayId          String         @map("day_id")
  reflectionType ReflectionType @map("reflection_type")
  content        String
  createdAt      DateTime       @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  day  ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([userId, dayId, reflectionType])
  @@map("user_reflections")
}

model AdminSetting {
  key   String @id
  value Json
}

model VipProModule {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String?
  icon        String   @default("Zap")
  image       String?
  description String?
  steps       Json
  links       Json
  checkItems  Json?
  statNumber  String?
  statLabel   String?
  orderIndex  Int      @default(0) @map("order_index")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  progress VipProProgress[]

  @@map("vip_pro_modules")
}

model VipProProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  moduleId    String    @map("module_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  checks      Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module VipProModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("vip_pro_progress")
}

model Transcription {
  id          String   @id @default(uuid())
  url         String
  title       String?
  status      String   @default("PENDING")
  text        String?
  error       String?
  videoPath   String?  @map("video_path")
  durationSec Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("transcriptions")
}

model TeamContact {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  contact   String?
  notes     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("team_contacts")
}

model SocialPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  platform  String?
  date      DateTime
  posted    Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("social_posts")
}

model TikTokShopCampaign {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  packType      Int      @default(500) @map("pack_type")
  baseCreators  Int      @default(5) @map("base_creators")
  extraCreators Int      @default(0) @map("extra_creators")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creators     TikTokCreator[]
  sales        TikTokSale[]
  slotPayments MembershipPayment[]

  @@map("tiktok_shop_campaigns")
}

model TikTokCreator {
  id         String              @id @default(uuid())
  campaignId String              @map("campaign_id")
  name       String
  tiktokUrl  String?             @map("tiktok_url")
  status     TikTokCreatorStatus @default(PENDIENTE)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  campaign TikTokShopCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sales    TikTokSale[]

  @@map("tiktok_creators")
}

model TikTokProduct {
  id             String   @id @default(uuid())
  name           String
  price          Float
  commissionRate Float    @default(25) @map("commission_rate")
  sponsorRate    Float    @default(5) @map("sponsor_rate")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sales TikTokSale[]

  @@map("tiktok_products")
}

model TikTokSale {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  creatorId  String   @map("creator_id")
  productId  String   @map("product_id")
  quantity   Int      @default(1)
  unitPrice  Float    @map("unit_price")
  saleDate   DateTime @map("sale_date")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  campaign    TikTokShopCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator     TikTokCreator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product     TikTokProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  commissions TikTokCommission[]

  @@map("tiktok_sales")
}

model TikTokCommission {
  id         String                 @id @default(uuid())
  saleId     String                 @map("sale_id")
  userId     String                 @map("user_id")
  type       TikTokCommissionType
  percent    Float
  amount     Float
  status     TikTokCommissionStatus @default(PENDING)
  createdAt  DateTime               @default(now()) @map("created_at")
  approvedAt DateTime?              @map("approved_at")

  sale TikTokSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tiktok_commissions")
}
