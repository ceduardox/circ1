# Production Environment Variables for Coolify
# Copy to .env and fill in your values

# Database (Coolify will provide these automatically if you add PostgreSQL service)
DATABASE_URL=postgresql://circulo:CHANGE_ME@postgres:5432/circulo1?schema=public
DB_USER=circulo
DB_PASSWORD=CHANGE_ME
DB_NAME=circulo1

# JWT - GENERA UNO SEGURO: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3001
NODE_ENV=production

# Frontend URL (tu dominio en Coolify)
FRONTEND_URL=https://tu-dominio.com

# pgAdmin (opcional)
PGADMIN_EMAIL=admin@tudominio.com
PGADMIN_PASSWORD=CHANGE_ME